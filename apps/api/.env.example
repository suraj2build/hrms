# ── CognixHR API — environment variables ─────────────────────────────────────
# Copy to `apps/api/.env` and fill in. This file documents EVERY var the API
# reads. Vars not marked "(optional)" must be set or the corresponding feature
# silently no-ops (startup only hard-fails on the Supabase core below).
#
# ⚠️  NEVER commit the real .env — it contains the service-role key and JWT
#     secret, which together grant full database access and token forgery.

# ── Core (REQUIRED — startup aborts without these) ────────────────────────────
# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key — FULL DB access, bypasses RLS. Backend-only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify incoming auth tokens. Must match the Supabase project
# JWT secret. (SUPABASE_JWT_SECRET is the canonical name; JWT_SECRET is a fallback.)
SUPABASE_JWT_SECRET=
JWT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# Public URL of the web app (used for links in emails, redirects).
APP_PUBLIC_URL=
WEB_URL=
# Owner portal URL (license/billing flows live there).
OWNER_APP_URL=
# Comma-separated Vercel project prefixes allowed by CORS (e.g. cognix-web,cognix).
VERCEL_PROJECT_PREFIXES=

# ── Email (Resend) — (optional; email no-ops if unset) ────────────────────────
RESEND_API_KEY=
# From address (display name is "CognixHR"). Defaults to onboarding@resend.dev.
EMAIL_FROM=

# ── Billing (Razorpay) — (optional; subscribe/billing breaks if unset) ────────
# See BILLING.md. Secret + webhook secret are backend-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STANDARD=
RAZORPAY_PLAN_ENTERPRISE=

# ── AI providers — (optional; AI features no-op if unset) ─────────────────────
# Which provider to use: anthropic | openai | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ── WhatsApp Business API — (optional; WhatsApp features no-op if unset) ────────
# Meta app secret for verifying X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Token checked against hub.verify_token during Meta webhook subscription setup.
WHATSAPP_WEBHOOK_SECRET=
# API token and phone number ID for outbound message delivery.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Maximum inbound WhatsApp webhook requests per IP per minute.
# Default: 300
WHATSAPP_WEBHOOK_RATE_LIMIT=300

# ── Leave ledger rollout flags — (optional) ───────────────────────────────────
# Dual-write/shadow toggles for the leave-ledger migration. Leave unset for
# default behaviour unless you are running the ledger cutover.
LEAVE_LEDGER_AUTHORITATIVE=
LEAVE_LEDGER_SHADOW=
