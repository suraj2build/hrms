# ── CognixHR web app — environment variables ──────────────────────────────────
# Copy to `.env` and fill in. Only VITE_-prefixed vars are exposed to the client.
# NEVER put the Supabase service-role key here — the client uses the anon key only.

# Supabase project URL (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; RLS enforces access)
VITE_SUPABASE_ANON_KEY=

# API base URL — LEAVE BLANK IN DEVELOPMENT.
# Dev uses the Vite proxy (see vite.config.ts). Set this only in production
# deployments where the API is on a different origin (e.g. https://api.cognixhr.com).
# VITE_API_URL=

# ── Observability (optional) ──────────────────────────────────────────────────
# Sentry DSN for front-end error tracking. Leave blank to disable (no-op).
# VITE_SENTRY_DSN=

# ── Billing (Razorpay, optional) ──────────────────────────────────────────────
# Public Razorpay Key ID for the checkout widget. Leave blank to disable the
# subscribe flow. Secret/webhook keys live on the backend only. See BILLING.md.
# VITE_RAZORPAY_KEY_ID=

# ── Demo (optional — DO NOT set on production) ────────────────────────────────
# These power the seeded-demo experience. They MUST be left unset on the real
# production portal: VITE_DEMO_LOGIN=true auto-signs-in any visitor to the demo
# account, which is an unauthenticated login path on a live deployment. Set
# these ONLY on dedicated demo deployments.
#
# VITE_DEMO_MODE=        # true → use the offline resolver (no real API)
# VITE_DEMO_LOGIN=       # true → auto sign-in to the seeded demo tenant via the real API
# VITE_DEMO_EMAIL=       # demo account email (defaults to demo@cognixhr.app)
# VITE_DEMO_PASSWORD=    # demo account password
